    {
      "name": "CompareByLastName",
      "implements": "IComparer<Note>",
      "fields": [],
      "methods": [
        {
          "returnType": "int",
          "name": "Compare",
          "params": "Note x, Note y",
          "body": "return string.Compare(x.LastName, y.LastName);"
        }
      ]
    },
    {
      "name": "CompareByFlat",
      "implements": "IComparer<Note>",
      "fields": [],
      "methods": [
        {
          "returnType": "int",
          "name": "Compare",
          "params": "Note x, Note y",
          "body": "return x.Flat.CompareTo(y.Flat);"
        }
      ]
    }

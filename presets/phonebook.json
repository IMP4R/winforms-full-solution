  "handlers": {
    "h_addClick": {
      "label": "добавитьToolStripMenuItem_Click",
      "eventType": "Click",
      "body": "var MyRecord = NewNote();\nvar r = await ShowDialog(\"AddForm\", MyRecord);\nif (r === DialogResult.OK) {\n    state.current = state.PhoneNote.Count;\n    state.PhoneNote.Add(MyRecord);\n    await PrintElement();\n}"
    },
    "h_editClick": {
      "label": "изменитьToolStripMenuItem_Click",
      "eventType": "Click",
      "body": "if ((state.current < 0) || (state.current >= state.PhoneNote.Count)) {\n    await MessageBox.Show(\"Нет записей для изменения!\", \"Ошибка\");\n    return;\n}\nvar MyRecord = state.PhoneNote[state.current];\nvar r = await ShowDialog(\"AddForm\", MyRecord);\nif (r === DialogResult.OK) {\n    state.PhoneNote[state.current] = MyRecord;\n    await PrintElement();\n}"
    },
    "h_deleteClick": {
      "label": "удалитьToolStripMenuItem_Click",
      "eventType": "Click",
      "body": "if ((state.current < 0) || (state.current >= state.PhoneNote.Count)) {\n    await MessageBox.Show(\"Нет записей для удаления!\", \"Ошибка\");\n    return;\n}\nstate.PhoneNote.RemoveAt(state.current);\nif (state.current >= state.PhoneNote.Count)\n    state.current = state.PhoneNote.Count - 1;\nawait PrintElement();"
    },
    "h_prevClick": {
      "label": "PreviousButton_Click",
      "eventType": "Click",
      "body": "if (state.current <= 0) {\n  await MessageBox.Show(\"Предыдущей записи не существует!\", \"Ошибка\");\n  return;\n}\nstate.current--;\nawait PrintElement();"
    },
    "h_nextClick": {
      "label": "NextButton_Click",
      "eventType": "Click",
      "body": "if (state.current >= state.PhoneNote.Count - 1) {\n  await MessageBox.Show(\"Следующей записи не существует!\", \"Ошибка\");\n  return;\n}\nstate.current++;\nawait PrintElement();"
    },
    "h_saveClick": {
      "label": "сохранитьToolStripMenuItem_Click",
      "eventType": "Click",
      "body": "var r = await saveFileDialog1.ShowDialog();\nif (r === 'OK') {\n  var sw = new StreamWriter(saveFileDialog1.FileName);\n  for (var i = 0; i < state.PhoneNote.Count; i++) {\n    var rec = state.PhoneNote[i];\n    sw.WriteLine(rec.LastName);\n    sw.WriteLine(rec.Name);\n    sw.WriteLine(rec.Patronymic);\n    sw.WriteLine(rec.Street);\n    sw.WriteLine(rec.House);\n    sw.WriteLine(rec.Flat);\n    sw.WriteLine(rec.Phone);\n  }\n  sw.Dispose();\n}"
    },
    "h_openClick": {
      "label": "открытьToolStripMenuItem_Click",
      "eventType": "Click",
      "body": "var r = await openFileDialog1.ShowDialog();\nif (r === 'OK') {\n  state.PhoneNote.Clear();\n  var sr = new StreamReader(openFileDialog1.FileName);\n  while (!sr.EndOfStream) {\n    var rec = NewNote();\n    rec.LastName = sr.ReadLine();\n    rec.Name = sr.ReadLine();\n    rec.Patronymic = sr.ReadLine();\n    rec.Street = sr.ReadLine();\n    rec.House = parseInt(sr.ReadLine());\n    rec.Flat = parseInt(sr.ReadLine());\n    rec.Phone = sr.ReadLine();\n    state.PhoneNote.Add(rec);\n  }\n  sr.Dispose();\n  if (state.PhoneNote.Count == 0)\n    state.current = -1;\n  else\n    state.current = 0;\n  await PrintElement();\n}"
    },
    "h_searchClick": {
      "label": "поискToolStripMenuItem_Click",
      "eventType": "Click",
      "body": "await ShowDialog(\"SearchNameForm\", state.PhoneNote);"
    },
    "h_sortLastNameClick": {
      "label": "сортироватьПоФамилииToolStripMenuItem_Click",
      "eventType": "Click",
      "body": "state.PhoneNote.Sort((x, y) => x.LastName.localeCompare(y.LastName));\nif (state.PhoneNote.Count > 0)\n    state.current = 0;\nawait PrintElement();"
    },
    "h_sortFlatClick": {
      "label": "сортироватьПоКвартиреToolStripMenuItem_Click",
      "eventType": "Click",
      "body": "state.PhoneNote.Sort((x, y) => x.Flat - y.Flat);\nif (state.PhoneNote.Count > 0)\n    state.current = 0;\nawait PrintElement();"
    },
    "h_addBtnClick": {
      "label": "AddButton_Click",
      "eventType": "Click",
      "body": "state.MyRecord.LastName = LastNameTextBox.Text;\nstate.MyRecord.Name = NameTextBox.Text;\nstate.MyRecord.Patronymic = PatronymicTextBox.Text;\nstate.MyRecord.Phone = PhoneMaskedTextBox.Text;\nstate.MyRecord.Street = StreetTextBox.Text;\nstate.MyRecord.House = parseInt(HouseNumericUpDown.Value);\nstate.MyRecord.Flat = parseInt(FlatNumericUpDown.Value);\nClose();"
    },
    "h_searchBtnClick": {
      "label": "SearchButton_Click",
      "eventType": "Click",
      "body": "ResultsTextBox.Text = \"\";\nvar i = 0;\nfor (var idx = 0; idx < state.PhoneNote.Count; idx++) {\n    var MyRecord = state.PhoneNote[idx];\n    if (MyRecord.LastName.includes(LastNameTextBox.Text) &&\n        MyRecord.Name.includes(NameTextBox.Text) &&\n        MyRecord.Patronymic.includes(PatronymicTextBox.Text)) {\n        i++;\n        ResultsTextBox.Text = ResultsTextBox.Text + i + \". \" + MyRecord.LastName + \" \" + MyRecord.Name + \" \" + MyRecord.Patronymic + \" — \" + MyRecord.Street + \", д.\" + MyRecord.House + \", кв.\" + MyRecord.Flat + \", тел.\" + MyRecord.Phone + \"\\r\\n\";\n    }\n}\nif (i == 0) {\n    ResultsTextBox.Text = \"Записей не найдено\";\n}"
    }
  }
}